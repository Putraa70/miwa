<section
  id="ultah"
  class="min-h-screen flex flex-col justify-center items-center px-4 py-16"
>
  <div class="mb-10">
    <svg
      id="fancy-rose"
      width="300"
      height="320"
      viewBox="0 0 300 320"
      fill="none"
      class="drop-shadow-2xl"
    >
      <!-- Shadow -->
      <ellipse
        cx="150"
        cy="295"
        rx="66"
        ry="22"
        fill="#ff93a3"
        fill-opacity="0.14"></ellipse>
      <!-- Batang -->
      <rect
        x="146"
        y="210"
        width="8"
        height="70"
        rx="4"
        fill="#d4718a"
        class="stem"></rect>
      <!-- Daun -->
      <ellipse
        cx="170"
        cy="250"
        rx="18"
        ry="7"
        fill="#fa4b85"
        fill-opacity="0.5"
        class="leaf"></ellipse>
      <ellipse
        cx="130"
        cy="250"
        rx="18"
        ry="7"
        fill="#fa4b85"
        fill-opacity="0.3"
        class="leaf"></ellipse>
      <!-- Outer Petals -->
      <path
        class="petal animate-petal delay-1"
        d="M150,55 Q220,80 220,180 Q205,240 150,240 Q95,240 80,180 Q80,80 150,55Z"
        fill="url(#p1)"></path>
      <path
        class="petal animate-petal delay-2"
        d="M150,60 Q205,80 205,180 Q190,220 150,220 Q110,220 95,180 Q95,80 150,60Z"
        fill="url(#p2)"
        opacity="0.8"></path>
      <path
        class="petal animate-petal delay-3"
        d="M150,68 Q190,90 190,175 Q178,210 150,210 Q122,210 110,175 Q110,90 150,68Z"
        fill="url(#p3)"
        opacity="0.6"></path>
      <!-- Inner Petals -->
      <ellipse
        class="petal animate-petal delay-4"
        cx="150"
        cy="135"
        rx="38"
        ry="42"
        fill="url(#p4)"
        opacity="0.8"></ellipse>
      <ellipse
        class="petal animate-petal delay-5"
        cx="150"
        cy="135"
        rx="28"
        ry="32"
        fill="url(#p5)"
        opacity="0.7"></ellipse>
      <!-- Swirl dan Pusat Mawar -->
      <circle
        class="center animate-center"
        cx="150"
        cy="140"
        r="20"
        fill="#fff0fa"
        opacity="0.95"></circle>
      <path
        class="center animate-center"
        d="M150 132 Q157 140 150 148 Q143 140 150 132Z"
        fill="#fbc2eb"
        opacity="0.9"></path>
      <defs>
        <linearGradient
          id="p1"
          x1="90"
          y1="90"
          x2="210"
          y2="230"
          gradientUnits="userSpaceOnUse"
        >
          <stop stop-color="#fa4b85"></stop>
          <stop offset="1" stop-color="#ffc1e3"></stop>
        </linearGradient>
        <linearGradient
          id="p2"
          x1="100"
          y1="100"
          x2="200"
          y2="210"
          gradientUnits="userSpaceOnUse"
        >
          <stop stop-color="#ff86b7"></stop>
          <stop offset="1" stop-color="#ffbad6"></stop>
        </linearGradient>
        <linearGradient
          id="p3"
          x1="110"
          y1="110"
          x2="190"
          y2="200"
          gradientUnits="userSpaceOnUse"
        >
          <stop stop-color="#ffb8d9"></stop>
          <stop offset="1" stop-color="#fa4b85"></stop>
        </linearGradient>
        <radialGradient id="p4" cx="0.5" cy="0.6" r="0.8">
          <stop offset="0%" stop-color="#ffc1e3"></stop>
          <stop offset="100%" stop-color="#fa4b85"></stop>
        </radialGradient>
        <radialGradient id="p5" cx="0.5" cy="0.5" r="0.7">
          <stop offset="0%" stop-color="#fff0fa"></stop>
          <stop offset="100%" stop-color="#ffc1e3"></stop>
        </radialGradient>
      </defs>
    </svg>
    <style>
      /* Animasi kelopak satu-satu */
      .petal,
      .center,
      .stem,
      .leaf {
        transform: scale(0.13);
        opacity: 0;
        transform-origin: 50% 75%;
        transition:
          transform 1.3s cubic-bezier(0.26, 0.76, 0.39, 1.09),
          opacity 1.1s cubic-bezier(0.22, 0.79, 0.54, 1.06);
      }
      .bloomed .petal,
      .bloomed .center,
      .bloomed .stem,
      .bloomed .leaf {
        transform: scale(1);
        opacity: 1;
      }
      /* Delay animasi kelopak */
      .delay-1 {
        transition-delay: 0.1s;
      }
      .delay-2 {
        transition-delay: 0.5s;
      }
      .delay-3 {
        transition-delay: 0.9s;
      }
      .delay-4 {
        transition-delay: 1.3s;
      }
      .delay-5 {
        transition-delay: 1.7s;
      }
      .animate-center {
        transition-delay: 2s;
      }
    </style>
    <div class="text-center mt-10">
      <h2
        class="text-3xl md:text-4xl font-bold text-pink-400 mb-4 animate-bounce"
      >
        Ini bunga buat kamu, Dutt!
      </h2>
      <p
        class="text-xl md:text-2xl text-pink-200 max-w-lg mx-auto leading-relaxed"
      >
        Semoga setelah bersamaku, hari-harimu selalu dipenuhi warna baru yang
        indah—setiap harinya. 🌸✨
      </p>
    </div>

    <script is:inline>
      // Aktifkan animasi saat SVG masuk viewport
      const svg = document.getElementById("fancy-rose");
      if (svg) {
        const onIntersect = (entries) => {
          if (entries[0].isIntersecting) {
            svg.classList.add("bloomed");
          }
        };
        const obs = new window.IntersectionObserver(onIntersect, {
          threshold: 0.15,
        });
        obs.observe(svg);
      }
    </script>
  </div>
</section>
